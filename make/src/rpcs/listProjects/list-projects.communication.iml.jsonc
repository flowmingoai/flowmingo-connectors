{
    "url": "/hiring/projects/v1",
    "method": "GET",
    "qs": {
        "limit": 100
    },
    "response": {
        "limit": 500,
        "iterate": "{{body.data}}",
        "output": {
            "label": "{{item.title}}",
            "value": "{{item.id}}"
        }
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{length(body.data) = 100}}"
    }
}
