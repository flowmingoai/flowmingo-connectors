[
    {
        "name": "com_interview_set_ids",
        "type": "select",
        "multiple": true,
        "label": "Assessments",
        "options": "rpc://listAssessments",
        "help": "AI Interviews, Role-plays, CV Evaluations, Skill Tests or Technical Tests. A Skill Test or Technical Test must be the only assessment, and attached to the hiring project you pick. Pick assessments, hiring projects, or both."
    },
    {
        "name": "com_project_ids",
        "type": "select",
        "multiple": true,
        "label": "Hiring projects",
        "options": "rpc://listProjects",
        "help": "Puts the candidate in these pipelines."
    },
    {
        "name": "com_job_post_ids",
        "type": "select",
        "label": "Job posts",
        "options": "rpc://listJobPosts",
        "multiple": true,
        "help": "The job posts the invitation is for. The list shows every job post of your account, with its creation date."
    },
    {
        "name": "email",
        "type": "email",
        "label": "Email",
        "help": "Where the invitation goes. Required for a Skill Test or Technical Test. Without an email, the address is read from the CV."
    },
    {
        "name": "firstname",
        "type": "text",
        "label": "First name"
    },
    {
        "name": "lastname",
        "type": "text",
        "label": "Last name"
    },
    {
        "name": "cv_link",
        "type": "url",
        "label": "CV link",
        "help": "A public link to the CV. Required to order a CV Evaluation."
    },
    {
        "name": "invitation_message",
        "type": "text",
        "label": "Invitation message",
        "multiline": true,
        "help": "A note added to the invitation email, 10 to 5000 characters."
    },
    {
        "name": "send_invite",
        "type": "boolean",
        "label": "Send invitation",
        "default": true,
        "help": "Turn off to add the candidate without emailing them."
    }
]
