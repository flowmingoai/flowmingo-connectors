{
    "url": "/hiring/submissions/{{encodeURL(parameters.submission_id)}}/rate/v1",
    "method": "POST",
    "body": "{{omit(parameters, 'submission_id')}}",
    "response": {
        "output": {
            "{{...}}": "{{body}}",
            "rated_at": "{{if(body.rated_at, parseDate(body.rated_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
    }
}
