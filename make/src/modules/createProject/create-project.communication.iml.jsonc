{
    "url": "/hiring/projects/v1",
    "method": "POST",
    "body": {
        "{{...}}": "{{parameters}}",
        "assessments": []
    },
    "response": {
        "output": {
            "{{...}}": "{{body}}",
            "created_at": "{{if(body.created_at, parseDate(body.created_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
    }
}
