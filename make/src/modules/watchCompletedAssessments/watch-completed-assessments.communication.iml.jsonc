{
    "url": "/events/v1",
    "method": "GET",
    "qs": {
        "event_type": "assessment.completed",
        "limit": 200
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": {
            "container": "{{body.data}}",
            "condition": "{{if(parameters.assessment_type, item.data.assessment_type = parameters.assessment_type, true)}}"
        },
        "trigger": {
            "id": "{{item.event_id}}",
            "date": "{{parseDate(item.timestamp, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
            "type": "date",
            "order": "desc"
        },
        "output": {
            "{{...}}": "{{item.data}}",
            "event_id": "{{item.event_id}}",
            "event_type": "{{item.event_type}}",
            "sub_event": "{{item.sub_event}}",
            "timestamp": "{{if(item.timestamp, parseDate(item.timestamp, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}",
            "completed_at": "{{if(item.data.completed_at, parseDate(item.data.completed_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
