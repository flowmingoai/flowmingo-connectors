{
    "url": "/hiring/projects/v1",
    "method": "GET",
    "qs": {
        "limit": 10
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": "{{body.data}}",
        "output": "{{item}}"
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{length(body.data) = 10}}"
    }
}
