{
    "url": "/hiring/projects/v1",
    "method": "GET",
    "qs": {
        "limit": 100
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": "{{body.data}}",
        "output": {
            "{{...}}": "{{item}}",
            "created_at": "{{if(item.created_at, parseDate(item.created_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{length(body.data) = 100}}"
    }
}
