{
    "url": "/events/v1",
    "method": "GET",
    "qs": {
        "event_type": "interview.status.update",
        "limit": 100
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": {
            "container": "{{body.data}}",
            "condition": "{{if(parameters.status, item.data.status = parameters.status, true)}}"
        },
        "trigger": {
            "id": "{{item.event_id}}",
            "date": "{{item.timestamp}}",
            "type": "date",
            "order": "desc"
        },
        "output": {
            "event_id": "{{item.event_id}}",
            "event_type": "{{item.event_type}}",
            "sub_event": "{{item.sub_event}}",
            "timestamp": "{{item.timestamp}}",
            "interview_set_id": "{{item.data.interview_set_id}}",
            "interview_name": "{{item.data.interview_name}}",
            "candidate_id": "{{item.data.candidate_id}}",
            "candidate_email": "{{item.data.candidate_email}}",
            "status": "{{item.data.status}}"
        }
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
