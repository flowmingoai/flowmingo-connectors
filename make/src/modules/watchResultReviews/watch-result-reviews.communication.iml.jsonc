{
    "url": "/events/v1",
    "method": "GET",
    "qs": {
        "event_type": "submission.review.update",
        "limit": 100
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": {
            "container": "{{body.data}}",
            "condition": "{{if(parameters.action, item.data.action = parameters.action, true)}}"
        },
        "trigger": {
            "id": "{{item.event_id}}",
            "date": "{{item.timestamp}}",
            "type": "date",
            "order": "desc"
        },
        "output": {
            "event_id": "{{item.event_id}}",
            "event_type": "{{item.event_type}}",
            "sub_event": "{{item.sub_event}}",
            "timestamp": "{{item.timestamp}}",
            "submission_id": "{{item.data.submission_id}}",
            "interview_set_id": "{{item.data.interview_set_id}}",
            "candidate_id": "{{item.data.candidate_id}}",
            "action": "{{item.data.action}}",
            "rating": "{{item.data.rating}}",
            "activity_id": "{{item.data.activity_id}}"
        }
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
