[
    {
        "name": "email",
        "type": "email",
        "label": "Email",
        "help": "Matched exactly, ignoring capital letters."
    },
    {
        "name": "q",
        "type": "text",
        "label": "Search text",
        "help": "Matched against name, email and CV text, up to 120 characters. Used when Email is empty."
