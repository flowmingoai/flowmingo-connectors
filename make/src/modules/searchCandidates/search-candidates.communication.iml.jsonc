{
    "url": "/hiring/candidates/v1",
    "method": "GET",
    "qs": {
        "email": "{{parameters.email}}",
        "q": "{{if(parameters.email, undefined, parameters.q)}}",
        "limit": 100
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": {
            "container": "{{body.data}}",
            "condition": "{{if(parameters.email, lower(item.email) = lower(parameters.email), true)}}"
        },
        "output": {
            "{{...}}": "{{item}}",
            "created_at": "{{if(item.created_at, parseDate(item.created_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{length(body.data) = 100}}"
    }
}
