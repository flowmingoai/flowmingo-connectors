{
    "url": "/hiring/submissions/{{encodeURL(parameters.submission_id)}}/detail/v1",
    "method": "GET",
    "response": {
        "output": {
            "{{...}}": "{{body}}",
            "submission_at": "{{if(body.submission_at, parseDate(body.submission_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}"
        }
    }
}
